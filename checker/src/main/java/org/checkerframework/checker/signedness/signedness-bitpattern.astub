package java.lang;

import org.checkerframework.checker.signedness.qual.BitPattern;

class Double {
  public static @BitPattern long doubleToLongBits(double value);

  public static @BitPattern long doubleToRawLongBits(double value);

  public static double longBitsToDouble(@BitPattern long bits);
}

class Float {
  public static @BitPattern int floatToIntBits(float value);

  public static @BitPattern int floatToRawIntBits(float value);

  public static float intBitsToFloat(@BitPattern int bits);
}
